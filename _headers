  Content-Security-Policy: default-src * data: blob: 'unsafe-inline' 'unsafe-eval'; script-src * data: blob: 'unsafe-inline' 'unsafe-eval'; style-src * data: blob: 'unsafe-inline'; img-src * data: blob:; font-src * data:; connect-src *; frame-ancestors 'self'; form-action 'none'; base-uri 'none'; sandbox allow-scripts allow-modals allow-forms
